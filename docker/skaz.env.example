# Образы предварительно загружаются из images.tar.gz.
SKAZ_IMAGE=skaz:local
SKAZ_BIND_IP=127.0.0.1
SKAZ_PORT=3100
PAPERCLIP_PUBLIC_URL=http://localhost:3100
PAPERCLIP_ALLOWED_HOSTNAMES=

# Существующая PostgreSQL 16: отдельная база для Сказа.
# Пароль в URI должен быть закодирован для URL.
# Для compose.skaz.postgres.yml эту строку можно оставить пустой.
DATABASE_URL=
# DATABASE_MIGRATION_URL=postgresql://migrator:encoded-password@postgres.internal:5432/skaz

# Три разных постоянных секрета. Для каждого: openssl rand -hex 32
BETTER_AUTH_SECRET=
PAPERCLIP_AGENT_JWT_SECRET=
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=

# Только для отдельной PostgreSQL из compose.skaz.postgres.yml.
# Используйте значение openssl rand -hex 32, без специальных символов URI.
# SKAZ_POSTGRES_PASSWORD=
# SKAZ_POSTGRES_IMAGE=postgres:16-alpine

# Файлы по умолчанию находятся в постоянном томе /paperclip.
PAPERCLIP_STORAGE_PROVIDER=local_disk

# Для существующего MinIO замените provider на s3 и заполните все поля ниже.
# Бакет должен быть создан заранее. Адрес доступен из контейнера Сказа.
# PAPERCLIP_STORAGE_S3_ENDPOINT=http://minio.internal:9000
# PAPERCLIP_STORAGE_S3_BUCKET=skaz
# PAPERCLIP_STORAGE_S3_REGION=us-east-1
# PAPERCLIP_STORAGE_S3_FORCE_PATH_STYLE=true
# PAPERCLIP_STORAGE_S3_PREFIX=skaz
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
